{
  "pairs": [
    {
      "name": "backend",
      "a": { "remote": "repo-a", "url": "https://github.com/negedng/repo-a.git" },
      "b": { "remote": "repo-b", "url": "https://github.com/negedng/repo-b.git" },
      "mappings": [
        { "a": "backend", "b": "" }
      ]
    }
  ],

  "identities": [
    {
      "repo-a": { "name": "X Mono",     "email": "x@corp.example.com" },
      "repo-b": { "name": "X External", "email": "x@gmail.example.com" }
    }
  ],

  "trailers": {
    "replayed": "Shadow-replayed"
  },

  "gitConfigOverrides": {
    "core.autocrlf": "false",
    "core.safecrlf": "false",
    "core.precomposeunicode": "true",
    "core.quotepath": "false"
  },

  "maxBuffer": 52428800,
  "shadowBranchPrefix": "shadow"
}
